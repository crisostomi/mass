
export http_proxy='http://login07:3140'
export https_proxy='http://login07:3140'
# Uppercase variants (many tools expect these)
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$https_proxy"

# RHEL/Rocky/CentOS family (likely on Leonardo)
export SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt

# If the above path does NOT exist, try the Debian/Ubuntu path:
# export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Requests honors this too; many libs use it
export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"

# (Optional) git and pip also have their own envs:
export GIT_SSL_CAINFO="$SSL_CERT_FILE"
export PIP_CERT="$SSL_CERT_FILE"


export HF_HOME="/leonardo_work/IscrC_SLEY/azirilli/HF"
export HF_DATASETS_CACHE="/leonardo_work/IscrC_SLEY/azirilli/HF"
export TRANSFORMERS_CACHE="/leonardo_work/IscrC_SLEY/azirilli/HF"